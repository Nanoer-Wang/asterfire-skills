# AsterFire Open API token. Required scopes for full Kit publishing:
# dev:read, dev:write, toolbox:read, kit:write, task:read; add file:read for downloads.
ASTERFIRE_TOKEN=

# Yunxiao personal access token and organization.
YUNXIAO_TOKEN=
YUNXIAO_ORGANIZATION_ID=

# Public service-connection UUIDs from Yunxiao. Do not use internal numeric IDs.
YUNXIAO_CODEUP_SERVICE_CONNECTION=
YUNXIAO_ACR_SERVICE_CONNECTION=

# Only required when build.backend is local. Yunxiao builds use the service connection above.
ACR_USERNAME=
ACR_PASSWORD=
