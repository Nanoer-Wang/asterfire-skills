# Asterfire Kit Dockerfile template: Python + pip + local project
FROM m.daocloud.io/docker.io/python:3.12.12-slim

ENV PATH=/app/bin:$PATH
ENV PYTHONPATH=/app:$PYTHONPATH

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates git \
    && if ! command -v python >/dev/null 2>&1; then ln -s "$(command -v python3)" /usr/local/bin/python; fi \
    && python -m pip install --no-cache-dir -r /app/requirements.txt \
    && python -m pip install --no-cache-dir "adam-community==1.2.5" \
    && rm -rf /var/lib/apt/lists/*

# Copy local project into immutable image path.
# Replace LocalProject with your local folder and ProjectName with your image path.
COPY LocalProject /opt/ProjectName

ENV PROJECT_HOME=/opt/ProjectName
ENV PYTHONPATH=/opt/ProjectName:/app:$PYTHONPATH

RUN command -v bash \
    && command -v python \
    && python --version \
    && python -c "import adam_community; print('Asterfire runtime ready')" \
    && ls -lah /opt/ProjectName

WORKDIR /app
CMD ["bash"]

LABEL Author="Your Name" \
      Version="1.0.0" \
      Description="Asterfire Kit image with local project"
